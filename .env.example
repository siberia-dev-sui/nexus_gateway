# NEXUS Gateway
PORT=3000
JWT_SECRET=change-me-long-random-secret

# Odoo nexus_mobile API
ODOO_URL=https://your-odoo.example.com
NEXUS_ADMIN_TOKEN=change-me-shared-token

# Sync behavior
# false: no ejecuta syncs al arrancar/reiniciar el gateway.
# true: mantiene los syncs automáticos al arrancar.
NEXUS_AUTO_SYNC_ON_START=false

# true: mantiene crons periódicos del gateway.
# false: desactiva crons periódicos; solo sync manual desde /admin/sync.
NEXUS_ENABLE_SYNC_CRONS=true

# Workers / validation
ENABLE_BULLMQ_WORKER=false
ENFORCE_PRICE_VALIDATION=false

# PostgreSQL container
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_URL=postgres://nexus:change-me-postgres-password@nexus_postgres:5432/nexus

# Redis container
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=nexus_redis
REDIS_URL=redis://:change-me-redis-password@nexus_redis:6379
